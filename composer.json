{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "laravel/laravel",
  "type": "project",
  "description": "The skeleton application for the Laravel framework.",
  "keywords": [
    "laravel",
    "framework"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "laravel/breeze": "^2.3",
    "laravel/framework": "^12.0",
    "laravel/telescope": "^5.11",
    "laravel/tinker": "^2.10.1",
    "spatie/laravel-medialibrary": "^11.14",
    "spatie/laravel-sluggable": "^3.7"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "larastan/larastan": "^3.4",
    "laravel/pail": "^1.2.2",
    "laravel/pint": "^1.13",
    "laravel/sail": "^1.41",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6",
    "peckphp/peck": "^0.1.0",
    "pestphp/pest": "^3.8",
    "pestphp/pest-plugin-laravel": "^3.2",
    "rector/rector": "^2.0",
    "soloterm/solo": "^0.4.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@php artisan config:clear",
      "@php artisan clear-compiled",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
      "@php artisan migrate --graceful --ansi"
    ],
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "npx concurrently -k -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail\" \"npm run dev\" --names=server,queue,logs,vite"
    ],
    "dev:quick": "php artisan serve & npm run dev",
    "lint": [
      "./vendor/bin/pint",
      "pnpm run lint"
    ],
    "lint:quick": "./vendor/bin/pint --test",
    "refactor": "./vendor/bin/rector process --dry-run",
    "fix": [
      "@test:types",
      "@refactor",
      "pnpm run lint:fix",
      "./vendor/bin/pint"
    ],
    "fix:apply": [
      "@test:types",
      "@refactor:apply",
      "pnpm run lint:fix",
      "./vendor/bin/pint"
    ],
    "test:typos": "./vendor/bin/peck",
    "test:lint": [
      "./vendor/bin/pint --test",
      "pnpm run test:lint"
    ],
    "test:unit": "./vendor/bin/pest --parallel",
    "test:unit:quick": "./vendor/bin/pest --parallel --exclude-group=slow",
    "test:unit:coverage": "./vendor/bin/pest --parallel --coverage",
    "test:types": "./vendor/bin/phpstan analyse --memory-limit=256M",
    "test:types:baseline": "./vendor/bin/phpstan analyse --generate-baseline --memory-limit=256M",
    "test:refactor": "./vendor/bin/rector process --dry-run",
    "test": [
      "@test:typos",
      "@test:unit",
      "@test:lint",
      "@test:types",
      "@test:refactor"
    ],
    "test:quick": [
      "@test:unit:quick",
      "@test:lint:quick",
      "@test:types"
    ],
    "deploy:prep": [
      "@test",
      "npm run build",
      "php artisan optimize:clear"
    ],
    "phpstan": "./vendor/bin/phpstan analyse --memory-limit=256M",
    "phpstan-baseline": "./vendor/bin/phpstan analyse --generate-baseline --memory-limit=256M"
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}